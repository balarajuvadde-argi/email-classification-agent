# Universal web application — local development only.
# Production values are supplied by template-web.yaml and AWS Secrets Manager.
APP_ENV=development
APP_BASE_URL=http://localhost:8000
DATABASE_URL=

# Create a Google OAuth Web application client. Its authorized redirect URI must be:
# http://localhost:8000/oauth/google/callback
GOOGLE_OAUTH_CLIENT_FILE=./web_client_secret.local.json

# Local-only key options. Do not use inline keys in staging or production.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Optional stable local session-token encryption key. If omitted, the local launcher generates
# an ephemeral Fernet key each start. Generate one with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# LOCAL_TOKEN_ENCRYPTION_KEY=

SERVICE_NAME=Inbox Pilot
OPERATOR_NAME=Local development operator
PRIVACY_CONTACT_EMAIL=privacy@localhost.invalid
SUPPORT_EMAIL=support@localhost.invalid
PRIVACY_EFFECTIVE_DATE=2026-09-02
PRIVACY_NOTICE_VERSION=2026-09-02.1
BACKUP_RECOVERY_DAYS=7

SESSION_TTL_SECONDS=86400
OAUTH_STATE_TTL_SECONDS=600
ACTION_PLAN_TTL_SECONDS=900
RUN_TTL_SECONDS=86400
AUTOMATIC_INTERVAL_SECONDS=28800
WORKER_LEASE_SECONDS=330
MANUAL_RUNS_PER_DAY=50
EML_PREVIEWS_PER_DAY=20
AUTOMATIC_RUNS_PER_DAY=3

# Default policy created automatically for new Gmail connections.
DEFAULT_CLASSIFICATION_LABELS=Acquisitions/On Market,Acquisitions/Off Market,Acquisitions/Wholesale,News
DEFAULT_GMAIL_QUERY=in:inbox
DEFAULT_CONFIDENCE_THRESHOLD=0.85
DEFAULT_MAX_MESSAGES_PER_RUN=10
DEFAULT_AUTOMATIC_ENABLED=true
SCHEDULER_CLAIM_DELAY_SECONDS=3600
AUTOMATIC_SCHEDULE_TIMEZONE=America/New_York
AUTOMATIC_SCHEDULE_LOCAL_TIMES=07:30,15:30,23:30
AUTOMATIC_SCHEDULE_WINDOW_SECONDS=3600
AUTOMATIC_LOOKBACK_HOURS=8

# Acquisition routing knobs. Defaults match the current Maurice/client workflow.
PROPERTY_LOOKUP_ENABLED=true
PROPERTY_LOOKUP_TIMEOUT_SECONDS=12
REPORT_EMAIL_ENABLED=true
# Leave blank to email the connected Gmail user after completed apply/scheduled runs.
REPORT_EMAIL_RECIPIENT=
CANDIDATE_SCAN_WINDOW=100
ON_MARKET_ROOT_DOMAINS=zillow.com,redfin.com,sefmatrixmail.com,onehome.com
ON_MARKET_LABEL=Acquisitions/On Market
WHOLESALE_LABEL=Acquisitions/Wholesale
ACQUISITION_MIAMI_DADE_LABEL_SUFFIX=Miami-Dade
ACQUISITION_IMPORTANT_LABEL_SUFFIX=Miami-Dade/Important
ACQUISITION_PRICE_TARGET=275000
ACQUISITION_REQUIRE_DOUBLE_LOT=true
ACQUISITION_EXCLUDED_MUNICIPALITIES=MIAMI GARDENS,OPA-LOCKA,OPALOCKA,NORTH MIAMI
ACQUISITION_QUALIFYING_LAND_USE_TERMS=SINGLE FAMILY,DUPLEX,2 UNITS,TOWNHOUSE
ACQUISITION_MIAMI_DADE_ZIPS=33010,33012,33013,33014,33015,33016,33018,33030,33031,33032,33033,33034,33035,33054,33055,33056,33101,33109,33122,33125,33126,33127,33128,33129,33130,33131,33132,33133,33134,33135,33136,33137,33138,33139,33140,33141,33142,33143,33144,33145,33146,33147,33149,33150,33154,33155,33156,33157,33158,33160,33161,33162,33165,33166,33167,33168,33169,33170,33172,33173,33174,33175,33176,33177,33178,33179,33180,33181,33182,33183,33184,33185,33186,33187,33189,33190,33193,33194,33196,33231
