# LEGACY SINGLE-MAILBOX CLI ONLY.
# For the universal web app use .env.web.example and docs/WEB_DEPLOYMENT.md.

# Mandatory mailbox safety check. The legacy agent refuses to run on another account.
EXPECTED_GMAIL_ADDRESS=

# Local OAuth option. For Lambda, use GMAIL_OAUTH_SECRET_ID instead.
GMAIL_TOKEN_FILE=./gmail_oauth_secret.json
# GMAIL_OAUTH_SECRET_ID=arn:aws:secretsmanager:REGION:ACCOUNT:secret:gmail-oauth-...

# Local OpenAI option. For Lambda, use OPENAI_API_KEY_SECRET_ID instead.
OPENAI_API_KEY=
# OPENAI_API_KEY_SECRET_ID=arn:aws:secretsmanager:REGION:ACCOUNT:secret:openai-key-...
OPENAI_MODEL=gpt-5.5

# Safety defaults. Set DRY_RUN=false only after reviewing a dry-run report.
DRY_RUN=true
USE_LLM=true
MARK_LOW_CONFIDENCE_PROCESSED=false
MIN_LLM_WHOLESALE_CONFIDENCE=0.85

WHOLESALE_LABEL=Wholesale
PROCESSED_LABEL=EmailAgent/Processed/v2
GMAIL_QUERY=in:inbox -in:spam -in:trash
MAX_MESSAGES_PER_RUN=50
MAX_THREAD_MESSAGES=6
MAX_BODY_CHARS=20000
MAX_THREAD_CONTEXT_CHARS=18000
